# ---------------------------------------------------------------------------
# Required: these two stay in the server environment.
# ---------------------------------------------------------------------------

# MongoDB connection string (e.g. MongoDB Atlas). Admin settings are stored here.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
# Database name (optional, defaults to "bridgecareers")
MONGODB_DB="bridgecareers"

# Signs admin sessions and encrypts the credentials saved in Admin → Settings.
# Use 32+ random characters. Changing it means re-entering those credentials.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: time zone for job closing dates (IANA name). Defaults to Africa/Lusaka.
SITE_TIMEZONE="Africa/Lusaka"

# ---------------------------------------------------------------------------
# Everything else is set in Admin → Settings:
#   Email (SMTP), Cloudflare R2, translation services, AI Gateway, cron secret.
#
# The environment variables below still work as a fallback (useful for CI or
# first setup); a value saved in the admin always takes priority.
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM, SITE_URL, NOTIFY_EMAILS
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_URL, R2_PRIVATE_BUCKET
#   TRANSLATOR, AZURE_TRANSLATOR_KEY, AZURE_TRANSLATOR_REGION, GOOGLE_TRANSLATE_API_KEY
#   AI_GATEWAY_API_KEY, CV_AI_MODEL, TRANSLATE_AI_MODEL
#   CRON_SECRET
# ---------------------------------------------------------------------------
